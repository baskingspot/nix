      local hash
      if ! hash="$(cd "$work/src" && ZIG_GLOBAL_CACHE_DIR="$work/cache" zig fetch "$2" 2>"$work/log")"; then
        cat "$work/log" >&2
        return 1
      fi
      if [ "$hash" != "$1" ]; then
        echo "$2 is $hash to Zig, not $1" >&2
