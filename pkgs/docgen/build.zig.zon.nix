      # rather than an unpacked `zig-pkg/` tree. Unpack it under the hash, the
      # way `--system` reads a package directory. The tarball's first
      # component is the hash; a package that also names itself below that is
      # fine, since `--system` accepts both depths.
      mkdir "$out/$1"
      tar -xzf "$work/cache/p/$1.tar.gz" -C "$out/$1" --strip-components=1 --no-same-owner
